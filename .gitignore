# =============================================================================
# WORLDWEAVER — .gitignore
# Node.js, Python, environment files, secrets, build artifacts, IDE caches
# NOTE: .kiro/ is intentionally NOT ignored (Kiro project configuration)
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
credentials/

# -----------------------------------------------------------------------------
# Node.js
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
yarn.lock
pnpm-lock.yaml
.npm/
.yarn/
# package-lock.json is intentionally tracked (reproducible npm installs).

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
sdist/
wheels/
pip-wheel-metadata/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# IDE & Local Caches
# -----------------------------------------------------------------------------

# VS Code / Kiro (user-specific settings only; .kiro/ is NOT ignored)
.vscode/settings.json
.vscode/launch.json
.vscode/.ropeproject

# JetBrains
.idea/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Logs & Temp
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
tmp/
temp/
